# Log level for the main process: debug | info | warn | error
LUMOSYNC_LOG_LEVEL=info

# Use a project-local DB under ./data instead of Electron userData (dev only)
LUMOSYNC_DEV_DB=true

# Shared file-backed sync store for multi-device demos (absolute or relative path)
# Point multiple instances at the same file to exchange operations.
# LUMOSYNC_SYNC_STORE=./data/sync-store.json

# Optional generic electron-updater feed (packaged builds only)
# LUMOSYNC_UPDATE_URL=https://updates.example.com/lumo-sync/
